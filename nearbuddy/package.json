{
  "name": "nearbuddy",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "api": "bun packages/resource-server/src/index.ts",
    "solver": "bun packages/solver/src/index.ts",
    "demo": "bun packages/demo/src/index.ts",
    "test": "bun test packages/protocol/src packages/solver/src packages/demo/src packages/keeper/src analysis",
    "lint": "biome check .",
    "format": "biome format --write .",
    "web": "bun --cwd web dev",
    "guarantor": "bun packages/demo/src/guarantor.ts",
    "arena-demo": "bun packages/demo/src/arena.ts",
    "real-swap": "bun packages/demo/src/swap.ts",
    "spectator": "bun packages/demo/src/spectator.ts",
    "join": "bun packages/demo/src/join.ts",
    "status": "scripts/arena-status.sh",
    "e2e": "bun e2e/run.ts",
    "verify-duel": "bun analysis/verify_duel.ts",
    "keeper": "bun packages/keeper/src/index.ts",
    "operator": "bun packages/keeper/src/operator-cli.ts",
    "gen:types": "bun packages/protocol/src/abi/gen.ts",
    "readout": "agents/.venv/bin/python analysis/night_readout.py"
  },
  "dependencies": {
    "@x402/evm": "2.31.0",
    "@x402/extensions": "2.31.0",
    "@x402/fetch": "2.31.0",
    "borsh": "2.0.0",
    "near-api-js": "7.4.0",
    "tweetnacl": "1.0.3",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
