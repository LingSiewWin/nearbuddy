# NearBuddy arena. Copy to .env (gitignored). Unset NEAR_AI_API_KEY runs the stub model.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017   # TEE-hosted (owned_by nearai); deepseek/deepseek-v4.1-flash is an external provider with no attestation
NEAR_AI_MODEL_A=deepseek-ai/DeepSeek-V4.1-Flash-1017
NEAR_AI_MODEL_B=Qwen/Qwen3.8-27B
# testnet|mainnet: RPC, explorer, key folder, account defaults and state file names (packages/protocol/src/network.ts,
# agents/config.py). The web derives NEXT_PUBLIC_NEAR_NETWORK from it; do not set that one. The single-value lines
# below override the table and must name the same network (a mismatch stops the process); delete them for mainnet.
NEAR_NETWORK=testnet
ARENA_CONTRACT=arena.nearbuddy-solver.testnet
NEAR_RPC=https://near-testnet.drpc.org   # views; rpc.testnet.near.org is deprecated (429); test.rpc.fastnear.com rate-limits bursts
NEAR_SEND_RPC=https://test.rpc.fastnear.com   # solver sends; drpc drops the wait on txs with an oracle yield (open_duel, resolve_duel)
SOLVER_ID=nearbuddy-solver.testnet
SOLVER_URL=http://127.0.0.1:4020
ONECLICK_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
ARENA_SECRET=
AGENT_SEED_A=
AGENT_SEED_B=
# AGENT_KEY_B=   # raw seed from a builder's `bun run join` (overrides AGENT_SEED_B; the arena drives their agent)
ONECLICK_ACCOUNT=            # funded mainnet account for `bun run real-swap` (one real 1Click swap, by hand)
SWAP_NEAR=0.5

# Clearinghouse (`bun run demo`, `bun run solver`, `bun run api`). Keys in ~/.near-credentials/testnet/<account>.json.
NEARBUDDY_CONTRACT=nearbuddy-vault.testnet
OWNER_ID=nearbuddy-owner.testnet
API_ID=nearbuddy-api.testnet
SOLVER_AUTO_AGE_MS=60000   # solver settles carried IOUs once the oldest is this old (or at SOLVER_AUTO_BATCH=200)

# One-shot flags, set on the command line rather than here:
#   CALLS=100 SKIP_SETTLE=1 bun run demo      paid calls per run; leave IOUs carried
#   DUELS=8 TARGET=b bun run spectator        injections per run; agent a, b or alt
#   ARENA_DEPLOYED=1 bun run test             adds the on-chain byte-parity test

# One sentence, one real order (`bun run buy "buy me a RM5 KFC voucher"`). Also uses NEAR_AI_API_KEY and ONECLICK_ACCOUNT above.
ORDER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017   # NEAR AI Cloud model that decides; must be in the paygate policy
ORDER_MAX_NEAR=1                                   # most wNEAR one run may deposit into the 1Click swap
PAYGATE=your-paygate-contract.testnet              # the paygate contract (testnet)
PAYGATE_AGENT=your-agent.testnet                   # the account whose function-call key is in .secrets/paygate-agent.key
PAYGATE_OWNER=your-owner.testnet                   # the account that opened an account and set the policy on the contract
