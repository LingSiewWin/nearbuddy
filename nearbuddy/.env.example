# NearBuddy arena. Copy to .env (gitignored). Unset NEAR_AI_API_KEY runs the stub model.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=deepseek/deepseek-v4.1-flash
ORACLE_KEY=
ARENA_CONTRACT=arena.nearbuddy-solver.testnet
SOLVER_ID=nearbuddy-solver.testnet
SOLVER_URL=http://127.0.0.1:4020
ONECLICK_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
ARENA_SECRET=change-me   # shared secret for the solver POST routes; runner and demo send x-arena-key
AGENT_SEED_A=
AGENT_SEED_B=
CHAOS_DEPOSIT=100000000000000000000000
ONECLICK_ACCOUNT=            # funded mainnet account for `pnpm real-swap` (one real 1Click swap, by hand)
SWAP_NEAR=0.5
